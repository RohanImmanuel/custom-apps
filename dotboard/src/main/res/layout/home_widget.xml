<?xml version="1.0" encoding="utf-8"?>
<!-- Same family as the weather widget: dot-matrix hero, dot meter, preset buttons, then reading cards on the same grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="4dp">

    <!-- the light: tap anywhere here to turn it on or off -->
    <LinearLayout
        android:id="@+id/lightPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/lightLevel"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:adjustViewBounds="true" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingEnd="3dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/lightName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <!-- brightness and warmth live in the overlay -->
                <ImageView
                    android:id="@+id/lightMore"
                    android:layout_width="34dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="-11dp"
                    android:paddingStart="11dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="8dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/powerIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:adjustViewBounds="true" />

                <TextView
                    android:id="@+id/lightMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textColor="#FF8C8C8C"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- dot level meter, lit up to the brightness in the light's colour -->
    <ImageView
        android:id="@+id/levelBar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:scaleType="fitXY" />

    <!-- presets: share the spare height with the readings; outlined in each preset's colour, the active one solid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:minHeight="52dp">

        <LinearLayout
            android:id="@+id/mode0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/outline"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/modeIcon0"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:adjustViewBounds="true" />

            <TextView
                android:id="@+id/modeLabel0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mode1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/outline"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/modeIcon1"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:adjustViewBounds="true" />

            <TextView
                android:id="@+id/modeLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mode2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/outline"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/modeIcon2"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:adjustViewBounds="true" />

            <TextView
                android:id="@+id/modeLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mode3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/outline"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/modeIcon3"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:adjustViewBounds="true" />

            <TextView
                android:id="@+id/modeLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- readings: dark filled cards on the presets' grid (outlined = buttons, filled = information) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:minHeight="52dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/fill"
            android:backgroundTint="#FF121212"
            android:gravity="center"
            android:orientation="vertical">

            <!-- icon beside the number, label alone underneath -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/tempIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="11dp"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/tempVal"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="TEMP"
                android:textColor="#FF8C8C8C"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/fill"
            android:backgroundTint="#FF121212"
            android:gravity="center"
            android:orientation="vertical">

            <!-- icon beside the number, label alone underneath -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/humIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="11dp"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/humVal"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="HUMID"
                android:textColor="#FF8C8C8C"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/fill"
            android:backgroundTint="#FF121212"
            android:gravity="center"
            android:orientation="vertical">

            <!-- icon beside the number, label alone underneath -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/co2Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="11dp"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/co2Val"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="CO₂ PPM"
                android:textColor="#FF8C8C8C"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/fill"
            android:backgroundTint="#FF121212"
            android:gravity="center"
            android:orientation="vertical">

            <!-- icon beside the number, label alone underneath -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/pmIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="11dp"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/pmVal"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="PM2.5"
                android:textColor="#FF8C8C8C"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- only when there's something to act on: stuffy air, hub unreachable -->
    <TextView
        android:id="@+id/homeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:paddingBottom="2dp"
        android:textColor="#FF8C8C8C"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
