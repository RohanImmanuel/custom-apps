<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <!-- clocks: dot-matrix images redrawn every minute (widgets can't use custom fonts on TextClock) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="11dp"
                android:adjustViewBounds="true"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mumbaiLabel"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:adjustViewBounds="true" 
                android:scaleType="fitEnd" />

            <ImageView
                android:id="@+id/mumbaiClock"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:adjustViewBounds="true"
                android:layout_marginTop="8dp" />

            <ImageView
                android:id="@+id/mumbaiDate"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:adjustViewBounds="true"
                android:layout_marginTop="8dp" 
                android:scaleType="fitEnd" />
        </LinearLayout>
    </LinearLayout>

    <!-- current weather -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <ImageView
            android:id="@+id/temp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="LOADING"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/feels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="#8C8C8C"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hilo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="DUBLIN"
                android:textColor="#8C8C8C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- day stats: 4 columns x 2 rows, columns sized to content and spread edge to edge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="FEELS"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/feelsIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/feelsLo"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:fontFamily="monospace"
                        android:text="/"
                        android:textColor="#4D4D4D"
                        android:textSize="10sp" />

                    <ImageView
                        android:id="@+id/feelsHi"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/windLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="WIND"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/windIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/wind"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- equal gaps between columns; outer columns sit flush with the edges -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/uvLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="UV"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/uvIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/uv"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="HUMIDITY"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/humidIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/humidity"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- equal gaps between columns; outer columns sit flush with the edges -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="RAIN MM"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/rainIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/rainTotal"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/airLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="AIR"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/airIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/air"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- equal gaps between columns; outer columns sit flush with the edges -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="NEXT RAIN"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/nextIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/nextRain"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/sunLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="SUNSET"
                android:textColor="#8C8C8C"
                android:textSize="8sp" />

            <!-- icon sits on the value's line, same height, so they align -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/sunIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />

                    <ImageView
                        android:id="@+id/sunTime"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:background="@drawable/outline"
        android:backgroundTint="#FF262626"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:maxLines="3"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />

    <!-- hourly rain; takes whatever height is left -->
    <ImageView
        android:id="@+id/rain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/updated"
        android:paddingEnd="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="end"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="#4D4D4D"
        android:textSize="8sp" />
</LinearLayout>
