<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- per-minute redraw of the dot-matrix clock -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- city-level weather; background so the widget can refresh it on its own -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- event dots and agenda on the calendar widget -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application android:label="Dotboard">
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".WeatherWidget"
            android:exported="true"
            android:label="Weather + Mumbai clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <activity
            android:name=".LightActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=".light"
            android:theme="@style/Overlay" />

        <activity
            android:name=".HubPairActivity"
            android:exported="false"
            android:label="Pair IKEA hub"
            android:theme="@android:style/Theme.DeviceDefault" />

        <receiver
            android:name=".HomeWidget"
            android:exported="true"
            android:label="IKEA home">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_info" />
        </receiver>

        <!-- day and year overlays opened from the calendar widget -->
        <activity
            android:name=".DayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=".calendar"
            android:theme="@style/Overlay" />
        <activity
            android:name=".YearActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=".calendar"
            android:theme="@style/Overlay" />

        <receiver
            android:name=".CalendarWidget"
            android:exported="true"
            android:label="Month calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>
    </application>
</manifest>
